{
  "name": "claude-otel-collector",
  "private": true,
  "workspaces": [
    "lib",
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run build:lib && cd server && npm run dev",
    "dev:web": "npm run build:lib && cd web && npm run dev",
    "dev": "npm run build:lib && concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "build:lib": "cd lib && npm run build",
    "build": "cd lib && npm run build && cd ../server && npm run build && cd ../web && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "shell-quote": "1.9.0",
    "brace-expansion": "5.0.9",
    "defu": "6.1.5",
    "effect": "3.20.0",
    "fast-uri": "3.1.5",
    "flatted": "3.4.2",
    "form-data": "4.0.6",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "react-router": "7.18.2",
    "@hono/node-server": "1.19.15",
    "qs": "6.15.2",
    "@babel/core": "7.29.6",
    "body-parser": "2.3.0",
    "esbuild": "0.28.1",
    "picomatch": "4.0.4",
    "router": {
      "path-to-regexp": "8.4.0"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "vitest": {
      "vite": "7.3.6"
    }
  }
}
